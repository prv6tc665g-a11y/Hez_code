# Copy to .env and adjust. All values are optional.

# Scope gate: true = only domains from scope.txt may be harvested.
# Leave unset to auto-enable as soon as scope.txt has entries.
DF_ENFORCE_SCOPE=true
DF_SCOPE_FILE=scope.txt

# Serve the bundled offline demo corpus instead of the network (great for a first run).
DF_DEMO=0

# Politeness / caching
DF_DELAY=1.5
DF_CACHE_TTL=43200
DF_CACHE_DIR=.dorkforge-cache

# Output
DF_OUTPUT_DIR=outputs
DF_LEADS_FILE=outputs/leads.json

# Optional shared secret: if set, send X-API-Token on /api calls
# and ?token=... on the WebSocket.
DF_API_TOKEN=
